<Window x:Class="SuperDucker.App.AddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SuperDucker.App"
        Title="AddDialog"
        Height="500" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="10" Background="{StaticResource BgDarkBrush}"
            BorderBrush="{StaticResource BgCardHoverBrush}" BorderThickness="1" Margin="4">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" BlurRadius="12" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <DockPanel>
            <!-- ═══ Title bar (top, draggable) ═══ -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BgMediumBrush}"
                    CornerRadius="10,10,0,0" Padding="18,10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="&#x2715;" Width="30" Height="24"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" Click="Cancel_Click" Cursor="Hand"/>
                    <TextBlock x:Name="DialogTitle" Text="&#x6DFB;&#x52A0;&#x7A0B;&#x5E8F;"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- ═══ Bottom buttons (pinned) ═══ -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource BgMediumBrush}"
                    CornerRadius="0,0,10,10" Padding="18,10">
                <DockPanel>
                    <TextBlock x:Name="TxtError" DockPanel.Dock="Left"
                               Foreground="{StaticResource AccentOrangeBrush}"
                               FontSize="12" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="240"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#x53D6;&#x6D88;" Style="{StaticResource FlatButton}"
                                Width="80" Margin="0,0,10,0"
                                Click="Cancel_Click"/>
                        <Button x:Name="BtnConfirm" Content="&#x786E;&#x5B9A;&#x6DFB;&#x52A0;"
                                Style="{StaticResource FlatButton}"
                                Background="{StaticResource AccentBlueBrush}"
                                Foreground="White" FontWeight="SemiBold"
                                Width="100"
                                Click="Confirm_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ Form fields (scrollable middle) ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <!-- Abbreviation -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="&#x7F29;&#x5199; *&#xFF08;&#x5927;&#x5199;&#x82F1;&#x6587;&#xFF0C;&#x7528;&#x4E8E; Win+R &#x542F;&#x52A8;&#xFF09;"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAbbreviation" MaxLength="20"
                                 CharacterCasing="Upper"
                                 Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="TxtAbbreviation_TextChanged"/>
                    </StackPanel>

                    <!-- Target Path / URL -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock x:Name="LblTarget" Text="&#x7A0B;&#x5E8F;&#x8DEF;&#x5F84; *"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button x:Name="BtnBrowse" DockPanel.Dock="Right" Content="&#x6D4F;&#x89C8;"
                                    Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                                    Click="BtnBrowse_Click"/>
                            <TextBox x:Name="TxtTargetPath"
                                     Style="{StaticResource SearchBoxStyle}"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- URL Actions (visible only in URL mode) -->
                    <StackPanel x:Name="UrlActions" Margin="0,0,0,12" Visibility="Collapsed"
                                Orientation="Horizontal">
                        <Button x:Name="BtnTestUrl" Content="&#x2714; &#x6D4B;&#x8BD5;&#x8FDE;&#x63A5;"
                                Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                                Click="BtnTestUrl_Click"/>
                        <Button x:Name="BtnFetchIcon" Content="&#x2B07; &#x83B7;&#x53D6;&#x56FE;&#x6807;"
                                Style="{StaticResource FlatButton}"
                                Click="BtnFetchIcon_Click"/>
                        <TextBlock x:Name="TxtUrlStatus" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Friendly Name -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="&#x53CB;&#x597D;&#x540D;&#x79F0;&#xFF08;&#x4E2D;&#x6587;&#x540D;&#xFF0C;&#x6309; Ctrl &#x65F6;&#x663E;&#x793A;&#xFF09;"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtFriendlyName"
                                 Style="{StaticResource SearchBoxStyle}"/>
                    </StackPanel>

                    <!-- Description -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="&#x63CF;&#x8FF0;&#xFF08;&#x9F20;&#x6807;&#x60AC;&#x505C;&#x65F6;&#x663E;&#x793A;&#xFF09;"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtDescription"
                                 Style="{StaticResource SearchBoxStyle}"/>
                    </StackPanel>

                    <!-- Category -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="&#x5206;&#x7C7B;&#xFF08;&#x53EF;&#x9009;&#xFF09;"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtCategory"
                                 Style="{StaticResource SearchBoxStyle}"/>
                    </StackPanel>

                    <!-- Custom Icon (visible only in URL mode) -->
                    <StackPanel x:Name="IconSection" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="&#x56FE;&#x6807;&#xFF08;&#x53EF;&#x81EA;&#x5B9A;&#x4E49;&#xFF09;"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40"
                                    CornerRadius="6" Background="{StaticResource BgCardBrush}"
                                    Margin="0,0,10,0">
                                <Image x:Name="IconPreview" Width="32" Height="32"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <Button x:Name="BtnPickIcon" DockPanel.Dock="Right" Content="&#x9009;&#x62E9;&#x56FE;&#x7247;"
                                    Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                                    Click="BtnPickIcon_Click"/>
                            <TextBlock x:Name="TxtIconInfo"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
