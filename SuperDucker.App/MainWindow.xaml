<Window x:Class="SuperDucker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SuperDucker.App"
        mc:Ignorable="d"
        Title="SuperDucker"
        Icon="pack://application:,,,/LOGO.ico"
        Height="620" Width="860"
        MinHeight="400" MinWidth="560"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <local:BoolToVis x:Key="BV"/>
        <local:BoolToCollapse x:Key="BC"/>

        <!-- Shared item template for grid tiles -->
        <DataTemplate x:Key="GridItemTemplate">
            <Button Style="{StaticResource AppItemStyle}"
                    Visibility="{Binding Visibility}"
                    Click="AppItem_Click" MouseDoubleClick="AppItem_DoubleClick" Tag="{Binding}"
                    PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Item_PreviewMouseMove">
                <Button.ToolTip>
                    <ToolTip Background="#FF2E3045" Foreground="#FFE8EAFF"
                             BorderBrush="#FF3D3F5A" Padding="10,8"
                             Content="{Binding TooltipText}"/>
                </Button.ToolTip>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="&#x4EE5;&#x7BA1;&#x7406;&#x5458;&#x8EAB;&#x4EFD;&#x8FD0;&#x884C;" Click="RunAsAdminItem_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x6253;&#x5F00;&#x6240;&#x5728;&#x6587;&#x4EF6;&#x5939;" Click="OpenFolderItem_Click" Tag="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="&#x7F16;&#x8F91;..." Click="EditItem_Click" Tag="{Binding}"/>
                        <MenuItem Header="&#x79FB;&#x52A8;&#x5230;" Tag="{Binding}" Loaded="MoveToMenu_Loaded"/>
                        <Separator/>
                        <MenuItem Header="&#x5220;&#x9664;" Click="RemoveItem_Click" Tag="{Binding}"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid Width="88" Height="88">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" HorizontalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="42" Height="42"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,-2,0" Stroke="{DynamicResource BgCardBrush}" StrokeThickness="2"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding DisplayName}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="11" FontWeight="Medium"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- List view item template - uses DynamicResource for theme updates -->
        <DataTemplate x:Key="ListItemTemplate">
            <Grid Margin="4,5" Tag="{Binding}"
                  PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="Item_PreviewMouseMove">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="22" Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-2,-2" Stroke="{DynamicResource BgCardBrush}" StrokeThickness="2"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                <Border Grid.Column="2" CornerRadius="4" Padding="6,2" Background="{DynamicResource BgCardBrush}"
                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,6,0">
                    <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <Border Grid.Column="3" CornerRadius="4" Padding="6,2" Background="{DynamicResource BgCardHoverBrush}"
                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,8,0"
                        Visibility="{Binding CategoryVisibility}">
                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource AccentOrangeBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="68"/>
                </Border>
                <TextBlock Grid.Column="4" Text="{Binding Description}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- ═══ Root ═══ -->
    <Border CornerRadius="10" Background="{DynamicResource BgDarkBrush}" Margin="6"
            BorderBrush="{DynamicResource BgCardHoverBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" BlurRadius="12" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="*"/>     <!-- Body (tabs + content) -->
                <RowDefinition Height="Auto"/>  <!-- Status bar -->
            </Grid.RowDefinitions>

            <!-- ═══ Title Bar ═══ -->
            <Border Grid.Row="0" Background="{DynamicResource BgMediumBrush}"
                    CornerRadius="10,10,0,0" Padding="14,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="&#x5E97;" Width="34" Height="26" Margin="2,0"
                                Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0" Click="Shop_Click" Cursor="Hand" ToolTip="&#x5546;&#x5E97;"
                                FontSize="13" FontWeight="Medium"/>
                        <Button Content="&#x2699;" Width="34" Height="26" Margin="2,0"
                                Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0" Click="Settings_Click" Cursor="Hand" ToolTip="&#x8BBE;&#x7F6E;"
                                FontSize="14"/>
                        <Button Content="&#x2015;" Width="34" Height="26" Margin="2,0"
                                Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0" Click="MinimizeButton_Click" Cursor="Hand" ToolTip="&#x6700;&#x5C0F;&#x5316;"/>
                        <Button Content="&#x2715;" Width="34" Height="26" Margin="2,0"
                                Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0" Click="CloseButton_Click" Cursor="Hand" ToolTip="&#x5173;&#x95ED;"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SuperDucker" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VersionText" FontSize="11" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   ToolTip="&#x5F53;&#x524D;&#x7248;&#x672C;"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ Body ═══ -->
            <Grid Grid.Row="1">
                <!-- Horizontal layout: tabs on top -->
                <Grid x:Name="HorizontalLayout" Visibility="{Binding IsTabHorizontal, Converter={StaticResource BV}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BgCardBrush}" BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="HTabItems" ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}" Style="{StaticResource TabButtonStyle}"
                                                Click="Tab_Click" Tag="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="&#x91CD;&#x547D;&#x540D;" Click="RenameTab_Click" Tag="{Binding}"/>
                                                    <MenuItem Header="&#x5220;&#x9664;" Click="DeleteTab_Click" Tag="{Binding}"
                                                              Visibility="{Binding IsBuiltIn, Converter={StaticResource BC}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="&#x79FB;&#x52A8;&#x5230;" Tag="{Binding}" Loaded="TabMoveToMenu_Loaded"/>
                                                    <Separator/>
                                                    <MenuItem Header="&#x65B0;&#x5EFA; Tab" Click="NewTab_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="&#x5207;&#x6362;&#x4E3A;&#x7EB5;&#x5411; Tab" Click="ToggleOrientation_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <!-- Content area -->
                    <Grid Grid.Row="1" x:Name="HContentArea"/>
                </Grid>

                <!-- Vertical layout: tabs on left -->
                <Grid x:Name="VerticalLayout" Visibility="{Binding IsTabVertical, Converter={StaticResource BV}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="{DynamicResource BgCardBrush}" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl x:Name="VTabItems" ItemsSource="{Binding Tabs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}" Style="{StaticResource TabButtonVerticalStyle}"
                                                    Click="Tab_Click" Tag="{Binding}">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="&#x91CD;&#x547D;&#x540D;" Click="RenameTab_Click" Tag="{Binding}"/>
                                                        <MenuItem Header="&#x5220;&#x9664;" Click="DeleteTab_Click" Tag="{Binding}"
                                                                  Visibility="{Binding IsBuiltIn, Converter={StaticResource BC}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="&#x79FB;&#x52A8;&#x5230;" Tag="{Binding}" Loaded="TabMoveToMenu_Loaded"/>
                                                        <Separator/>
                                                        <MenuItem Header="&#x65B0;&#x5EFA; Tab" Click="NewTab_Click"/>
                                                        <Separator/>
                                                        <MenuItem Header="&#x5207;&#x6362;&#x4E3A;&#x6A2A;&#x5411; Tab" Click="ToggleOrientation_Click"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Column="1" x:Name="VContentArea"/>
                </Grid>

                <!-- Settings panel (overlay, hidden by default) -->
                <Border x:Name="SettingsPanel" Visibility="Collapsed"/>

                <!-- Shop panel (overlay, hidden by default) -->
                <Border x:Name="ShopPanel" Visibility="Collapsed"/>
            </Grid>

            <!-- ═══ Status Bar ═══ -->
            <Border Grid.Row="2" Background="{DynamicResource BgMediumBrush}"
                    CornerRadius="0,0,10,10" Padding="14,5">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   Text="{Binding FriendlyModeHint}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                            <Run Text="&#x9879;&#x76EE;:"/>
                            <Run Text="{Binding TotalItems, Mode=OneWay}" Foreground="{DynamicResource AccentGreenBrush}"/>
                            <Run Text="  PATH:"/>
                        </TextBlock>
                        <Ellipse Width="8" Height="8" Margin="4,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource AccentGreenBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPathRegistered}" Value="False">
                                            <Setter Property="Fill" Value="{DynamicResource AccentOrangeBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
